{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "CloudFormationDeploy",
			"Effect": "Allow",
			"Action": [
				"cloudformation:CreateStack",
				"cloudformation:UpdateStack",
				"cloudformation:DeleteStack",
				"cloudformation:DescribeStacks",
				"cloudformation:ListStackResources",
				"cloudformation:DescribeStackEvents",
				"cloudformation:GetTemplateSummary",
				"cloudformation:CreateChangeSet",
				"cloudformation:ExecuteChangeSet",
				"cloudformation:DescribeChangeSet",
				"cloudformation:DeleteChangeSet"
			],
			"Resource": "*"
		},
		{
			"Sid": "S3ArtifactsAndFrontend",
			"Effect": "Allow",
			"Action": [
				"s3:ListBucket",
				"s3:GetBucketLocation",
				"s3:GetBucketTagging",
				"s3:PutBucketTagging",
				"s3:GetObject",
				"s3:PutObject",
				"s3:DeleteObject"
			],
			"Resource": [
				"arn:aws:s3:::clean-ddd-*-artifacts",
				"arn:aws:s3:::clean-ddd-*-artifacts/*",
				"arn:aws:s3:::clean-ddd-*-web",
				"arn:aws:s3:::clean-ddd-*-web/*"
			]
		},
		{
			"Sid": "CloudFrontInvalidateAndRead",
			"Effect": "Allow",
			"Action": [
				"cloudfront:GetDistribution",
				"cloudfront:ListDistributions",
				"cloudfront:CreateInvalidation"
			],
			"Resource": "*"
		},
		{
			"Sid": "EcrProvisionAndPushForSamImageDeploy",
			"Effect": "Allow",
			"Action": [
				"ecr:GetAuthorizationToken",
				"ecr:CreateRepository",
				"ecr:DescribeRepositories",
				"ecr:GetRepositoryPolicy",
				"ecr:SetRepositoryPolicy",
				"ecr:TagResource",
				"ecr:BatchCheckLayerAvailability",
				"ecr:BatchGetImage",
				"ecr:GetDownloadUrlForLayer",
				"ecr:InitiateLayerUpload",
				"ecr:UploadLayerPart",
				"ecr:CompleteLayerUpload",
				"ecr:PutImage"
			],
			"Resource": "*"
		},
		{
			"Sid": "CloudFrontProvisionForApiEdge",
			"Effect": "Allow",
			"Action": [
				"cloudfront:CreateDistribution",
				"cloudfront:UpdateDistribution",
				"cloudfront:DeleteDistribution",
				"cloudfront:GetDistributionConfig",
				"cloudfront:TagResource",
				"cloudfront:UntagResource"
			],
			"Resource": "*"
		},
		{
			"Sid": "CloudWatchAlarmProvision",
			"Effect": "Allow",
			"Action": [
				"cloudwatch:PutMetricAlarm",
				"cloudwatch:DeleteAlarms",
				"cloudwatch:DescribeAlarms"
			],
			"Resource": "*"
		},
		{
			"Sid": "SnsTopicProvision",
			"Effect": "Allow",
			"Action": [
				"sns:CreateTopic",
				"sns:DeleteTopic",
				"sns:SetTopicAttributes",
				"sns:GetTopicAttributes",
				"sns:Subscribe",
				"sns:Unsubscribe",
				"sns:ListSubscriptionsByTopic",
				"sns:TagResource",
				"sns:UntagResource",
				"sns:ListTagsForResource"
			],
			"Resource": "*"
		},
		{
			"Sid": "IamPassRoleForSam",
			"Effect": "Allow",
			"Action": ["iam:PassRole"],
			"Resource": "*"
		},
		{
			"Sid": "SqsProvisionForStack",
			"Effect": "Allow",
			"Action": [
				"sqs:CreateQueue",
				"sqs:DeleteQueue",
				"sqs:GetQueueAttributes",
				"sqs:SetQueueAttributes",
				"sqs:GetQueueUrl",
				"sqs:TagQueue",
				"sqs:UntagQueue",
				"sqs:ListQueueTags"
			],
			"Resource": [
				"arn:aws:sqs:*:*:OutboxDispatch*",
				"arn:aws:sqs:*:*:*OutboxDispatch*"
			]
		},
		{
			"Sid": "DynamoDbProvisionForStack",
			"Effect": "Allow",
			"Action": [
				"dynamodb:CreateTable",
				"dynamodb:DeleteTable",
				"dynamodb:DescribeTable",
				"dynamodb:UpdateTable",
				"dynamodb:TagResource",
				"dynamodb:UntagResource",
				"dynamodb:ListTagsOfResource"
			],
			"Resource": "arn:aws:dynamodb:*:*:table/clean-ddd-avatar-*"
		},
		{
			"Sid": "DynamoDbDataPlaneForAvatarSeed",
			"Effect": "Allow",
			"Action": [
				"dynamodb:BatchWriteItem",
				"dynamodb:GetItem",
				"dynamodb:PutItem",
				"dynamodb:UpdateItem"
			],
			"Resource": [
				"arn:aws:dynamodb:*:*:table/clean-ddd-avatar-*",
				"arn:aws:dynamodb:*:*:table/clean-ddd-avatar-*/index/*"
			]
		},
		{
			"Sid": "LambdaProvisionForStack",
			"Effect": "Allow",
			"Action": [
				"lambda:CreateFunction",
				"lambda:DeleteFunction",
				"lambda:GetFunction",
				"lambda:GetFunctionConfiguration",
				"lambda:UpdateFunctionCode",
				"lambda:UpdateFunctionConfiguration",
				"lambda:PutFunctionConcurrency",
				"lambda:DeleteFunctionConcurrency",
				"lambda:AddPermission",
				"lambda:RemovePermission",
				"lambda:TagResource",
				"lambda:UntagResource"
			],
			"Resource": "arn:aws:lambda:*:*:function:clean-ddd-*"
		},
		{
			"Sid": "LambdaEventSourceMappingProvision",
			"Effect": "Allow",
			"Action": [
				"lambda:CreateEventSourceMapping",
				"lambda:DeleteEventSourceMapping",
				"lambda:GetEventSourceMapping",
				"lambda:UpdateEventSourceMapping",
				"lambda:ListEventSourceMappings",
				"lambda:TagResource",
				"lambda:UntagResource"
			],
			"Resource": "*"
		},
		{
			"Sid": "IamRoleProvisionForSamGeneratedRoles",
			"Effect": "Allow",
			"Action": [
				"iam:CreateRole",
				"iam:DeleteRole",
				"iam:GetRole",
				"iam:PutRolePolicy",
				"iam:DeleteRolePolicy",
				"iam:AttachRolePolicy",
				"iam:DetachRolePolicy",
				"iam:TagRole",
				"iam:UntagRole"
			],
			"Resource": "arn:aws:iam::*:role/clean-ddd-*"
		},
		{
			"Sid": "ApiGatewayAndEventsProvisionForStack",
			"Effect": "Allow",
			"Action": [
				"apigateway:*",
				"events:PutRule",
				"events:DeleteRule",
				"events:DescribeRule",
				"events:PutTargets",
				"events:RemoveTargets",
				"events:TagResource",
				"events:UntagResource"
			],
			"Resource": "*"
		},
		{
			"Sid": "BudgetsProvisionForCostGuardrails",
			"Effect": "Allow",
			"Action": [
				"budgets:CreateBudget",
				"budgets:ModifyBudget",
				"budgets:DeleteBudget",
				"budgets:DescribeBudget",
				"budgets:CreateNotification",
				"budgets:ModifyNotification",
				"budgets:DeleteNotification",
				"budgets:DescribeNotificationsForBudget",
				"budgets:CreateSubscriber",
				"budgets:ModifySubscriber",
				"budgets:DeleteSubscriber",
				"budgets:TagResource",
				"budgets:UntagResource"
			],
			"Resource": "*"
		}
	]
}
