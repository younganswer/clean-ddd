# syntax=docker/dockerfile:1.6

FROM node:22-alpine AS build
WORKDIR /app/service/backend
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@9.15.5 --activate

COPY service/backend/package.json ./package.json
RUN pnpm install --no-frozen-lockfile

COPY service/backend ./
RUN pnpm build && pnpm prune --prod

FROM public.ecr.aws/lambda/nodejs:22
WORKDIR ${LAMBDA_TASK_ROOT}

COPY --from=build /app/service/backend/node_modules ./node_modules
COPY --from=build /app/service/backend/dist ./dist
COPY --from=build /app/service/backend/package.json ./package.json

CMD ["dist/src/lib/lambda/http.handler"]
