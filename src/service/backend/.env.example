NODE_ENV=dev
PORT=3000
PORT_LISTEN=true
SWAGGER_ENABLED=true

OUTBOX_CRON_ENABLED=false
OUTBOX_POLLING_ENABLED=false
OUTBOX_HANDLER_IMMEDIATE_DISPATCH=true
OUTBOX_DISPATCH_BATCH_SIZE=10
OUTBOX_ENQUEUE_STRICT=false
SQS_DISABLE_DELAY_SECONDS=false

APP.NAME=api
APP.CORS.URL=http://localhost:8080,http://localhost
APP.API.VERSION=v1

# Local(Postgres via docker-compose)
DATABASE_URL=postgresql://app:app@localhost:54322/clean_ddd
DATABASE_URL_PRIMARY=postgresql://app:app@localhost:54322/clean_ddd
DATABASE_URL_POOLED=postgresql://app:app@localhost:54322/clean_ddd

# LocalStack SQS
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:45666
SQS_OUTBOX_QUEUE_NAME=OutboxDispatchQueue.fifo
SQS_OUTBOX_QUEUE_URL=http://localhost:45666/000000000000/OutboxDispatchQueue.fifo

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=clean_ddd
MONGODB_AVATAR_COLLECTION=avatars

AVATAR_REPOSITORY_BACKEND=mongo
DYNAMODB_AVATAR_TABLE=clean-ddd-avatar
DYNAMODB_ENDPOINT=

TEST_DATABASE_URL=postgresql://app:app@localhost:54322/clean_ddd
