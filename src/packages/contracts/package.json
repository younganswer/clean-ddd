{
	"name": "@clean-ddd/contracts",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": "./index.ts"
	},
	"scripts": {
		"generate:types": "openapi-typescript openapi.yaml -o types.generated.ts",
		"generate:types:bff": "openapi-typescript openapi.bff.yaml -o types.bff.generated.ts",
		"check:generated:bff": "pnpm generate:types:bff && git diff --exit-code -- types.bff.generated.ts",
		"check:bff:route-drift": "node ./scripts/check-bff-route-drift.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "echo \"(skip)\"",
		"format": "prettier --write \"*.ts\""
	},
	"devDependencies": {
		"openapi-typescript": "^7.5.2",
		"prettier": "^3.4.2",
		"typescript": "^5.7.3"
	}
}
